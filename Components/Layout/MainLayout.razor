@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor Http

<div class="kiosk-shell">
    <header class="kiosk-header">
        <div class="brand">@_negocio</div>

        <AuthorizeView>
            <Authorized>
                <div class="user-block">
                    <span>Cajero: <strong>@context.User.FindFirst("nombre")?.Value</strong></span>
                    <form method="post" action="/logout" style="display:inline">
                        <input type="hidden" name="__RequestVerificationToken" value="@_logoutToken" />
                        <button type="submit" class="logout-btn">Cerrar sesion</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="kiosk-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrio un error inesperado.
    <a href="." class="reload">Recargar</a>
</div>

@code {
    private string _negocio = "SuperM";
    private string _logoutToken = string.Empty;

    protected override void OnInitialized()
    {
        _negocio = Config["Negocio:Nombre"] ?? "SuperM";
        var http = Http.HttpContext;
        if (http is not null)
        {
            _logoutToken = Antiforgery.GetAndStoreTokens(http).RequestToken ?? string.Empty;
        }
    }
}
