@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SuperMWeb.Application
@using SuperMWeb.Domain
@inject IDeudoresRepository DeudoresRepo
@inject AuthenticationStateProvider Auth

@* Equivalente de FrmAgregarDeuda del desktop: crea un deudor (con deuda
   inicial opcional) o edita uno existente permitiendole registrar una nueva
   deuda. El deudor y el cargo se guardan en una sola transaccion. *@

<div class="modal-backdrop" @onclick="Cancelar">
    <div class="modal modal-form" @onclick:stopPropagation="true" @onkeydown="OnKey" tabindex="0">
        <h2>@(EsEdicion ? "Editar deudor" : "Agregar deuda")</h2>

        @if (EsEdicion)
        {
            <p class="confirm-texto">Saldo actual: <strong>@_saldoActual.ToString("C0")</strong></p>
        }

        @if (_error is not null)
        {
            <div class="feedback error">@_error</div>
        }

        @if (_confirmacionCupo is not null)
        {
            <div class="feedback info">
                @_confirmacionCupo
                <div class="acciones-inline">
                    <button class="btn btn-secundario btn-mini" @onclick="() => _confirmacionCupo = null">Revisar</button>
                    <button class="btn btn-primario btn-mini" @onclick="GuardarConfirmado">Continuar</button>
                </div>
            </div>
        }

        <div class="form-rejilla">
            <div class="campo-form ancho-total">
                <label for="dNombre">Nombre del cliente *</label>
                <input id="dNombre" @bind="_nombre" @bind:event="oninput" autocomplete="off" />
            </div>

            <div class="campo-form">
                <label for="dIdent">Identificacion</label>
                <input id="dIdent" inputmode="numeric" @bind="_identificacion" @bind:event="oninput" autocomplete="off" />
            </div>

            <div class="campo-form">
                <label for="dTel">Telefono</label>
                <input id="dTel" inputmode="numeric" maxlength="10" @bind="_telefono" @bind:event="oninput" autocomplete="off" />
            </div>

            <div class="campo-form ancho-total">
                <label for="dDir">Direccion</label>
                <input id="dDir" @bind="_direccion" @bind:event="oninput" autocomplete="off" />
            </div>

            <div class="campo-form">
                <label for="dCupo">Cupo maximo</label>
                <input id="dCupo" inputmode="decimal" @bind="_cupoMaximo" @bind:event="oninput"
                       placeholder="Sin limite" autocomplete="off" />
            </div>

            <div class="campo-form">
                <label for="dObs">Observaciones</label>
                <input id="dObs" @bind="_observaciones" @bind:event="oninput" autocomplete="off" />
            </div>
        </div>

        <fieldset class="grupo-campos">
            <legend>@(EsEdicion ? "Registrar nueva deuda (opcional)" : "Deuda inicial (opcional)")</legend>
            <div class="form-rejilla">
                <div class="campo-form">
                    <label for="dValor">Valor</label>
                    <input id="dValor" inputmode="decimal" @bind="_valorDeuda" @bind:event="oninput" autocomplete="off" />
                </div>
                <div class="campo-form">
                    <label for="dDesc">Descripcion</label>
                    <input id="dDesc" @bind="_descripcionDeuda" @bind:event="oninput" autocomplete="off" />
                </div>
            </div>
        </fieldset>

        <div class="acciones">
            <button class="btn-secondary" @onclick="Cancelar">Cancelar (Esc)</button>
            <button class="btn-primary" disabled="@_guardando" @onclick="Guardar">
                @(_guardando ? "Guardando..." : EsEdicion ? "Actualizar" : "Agregar")
            </button>
        </div>
    </div>
</div>

@code {
    // 0 = alta. Cualquier otro valor carga ese deudor para editarlo.
    [Parameter] public int IdDeudor { get; set; }
    [Parameter] public EventCallback<string> OnGuardado { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private bool EsEdicion => IdDeudor > 0;

    private string _nombre = string.Empty;
    private string _identificacion = string.Empty;
    private string _telefono = string.Empty;
    private string _direccion = string.Empty;
    private string _cupoMaximo = string.Empty;
    private string _observaciones = string.Empty;
    private string _valorDeuda = string.Empty;
    private string _descripcionDeuda = string.Empty;

    private decimal _saldoActual;
    private bool _guardando;
    private string? _error;
    private string? _confirmacionCupo;
    private string? _usuario;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _usuario = auth.User.FindFirst(ClaimTypes.Name)?.Value;

        if (!EsEdicion) return;

        try
        {
            var d = await DeudoresRepo.ObtenerAsync(IdDeudor);
            if (d is null)
            {
                _error = "El deudor ya no existe.";
                return;
            }

            _nombre = d.NombreCliente;
            _identificacion = d.Identificacion ?? string.Empty;
            _telefono = d.Telefono ?? string.Empty;
            _direccion = d.Direccion ?? string.Empty;
            _cupoMaximo = d.CupoMaximo?.ToString("0.##") ?? string.Empty;
            _observaciones = d.Observaciones ?? string.Empty;
            _saldoActual = d.Saldo;
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el deudor: {ex.Message}";
        }
    }

    private async Task Guardar()
    {
        _error = null;
        _confirmacionCupo = null;

        var problema = await ValidarAsync();
        if (problema is not null)
        {
            _error = problema;
            return;
        }

        var cupo = LeerCupo();
        var valor = string.IsNullOrWhiteSpace(_valorDeuda)
            ? 0m
            : FormatosTexto.ParseValorMoneda(_valorDeuda.Trim());

        // El desktop pide confirmacion cuando la nueva deuda deja el saldo
        // por encima del cupo asignado.
        if (valor > 0 && cupo is > 0 && (_saldoActual + valor) > cupo.Value)
        {
            _confirmacionCupo = $"El saldo quedaria en {(_saldoActual + valor).ToString("C0")} " +
                                $"y supera el cupo de {cupo.Value.ToString("C0")}. Deseas continuar?";
            return;
        }

        await GuardarConfirmado();
    }

    private async Task GuardarConfirmado()
    {
        _confirmacionCupo = null;
        _guardando = true;

        try
        {
            var deudor = new Deudor
            {
                IdDeudor = IdDeudor,
                NombreCliente = _nombre.Trim(),
                Identificacion = _identificacion.Trim(),
                Telefono = _telefono.Trim(),
                Direccion = _direccion.Trim(),
                CupoMaximo = LeerCupo(),
                Observaciones = _observaciones.Trim()
            };

            var valor = string.IsNullOrWhiteSpace(_valorDeuda)
                ? 0m
                : FormatosTexto.ParseValorMoneda(_valorDeuda.Trim());

            if (EsEdicion)
            {
                await DeudoresRepo.ActualizarAsync(deudor, valor, _descripcionDeuda, _usuario);
                await OnGuardado.InvokeAsync("Deudor actualizado correctamente.");
            }
            else
            {
                await DeudoresRepo.CrearAsync(deudor, valor, _descripcionDeuda, _usuario);
                await OnGuardado.InvokeAsync("Deudor creado correctamente.");
            }
        }
        catch (Exception ex)
        {
            _error = $"No se pudo guardar el deudor: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private decimal? LeerCupo()
    {
        var cupo = _cupoMaximo.Trim();
        return cupo.Length == 0 ? null : FormatosTexto.ParseValorMoneda(cupo);
    }

    // Mismas reglas que FrmAgregarDeuda.aplicarValidaciones, en el mismo orden.
    private async Task<string?> ValidarAsync()
    {
        var nombre = _nombre.Trim();
        var identificacion = _identificacion.Trim();
        var telefono = _telefono.Trim();
        var cupo = _cupoMaximo.Trim();
        var valorDeuda = _valorDeuda.Trim();

        if (nombre.Length == 0) return "El nombre del cliente es obligatorio.";

        if (identificacion.Length > 0 && !FormatosTexto.IsNumber(identificacion))
            return "La identificacion solo debe contener numeros.";

        if (identificacion.Length > 0 &&
            await DeudoresRepo.ExisteIdentificacionAsync(identificacion, EsEdicion ? IdDeudor : null))
            return $"Ya existe un deudor registrado con la identificacion {identificacion}.";

        if (telefono.Length > 0 && !FormatosTexto.IsNumber(telefono))
            return "El telefono solo debe contener numeros.";

        if (telefono.Length > 10) return "El campo telefono solo debe tener 10 digitos.";

        if (cupo.Length > 0 && !FormatosTexto.IsNumberDecimal(cupo))
            return "El cupo maximo debe ser numerico.";

        if (valorDeuda.Length > 0)
        {
            if (!FormatosTexto.IsNumberDecimal(valorDeuda))
                return "El valor de la deuda debe ser numerico.";

            if (FormatosTexto.ParseValorMoneda(valorDeuda) <= 0)
                return "El valor de la deuda debe ser mayor a cero (0).";
        }

        return null;
    }

    private Task Cancelar() => OnCancelar.InvokeAsync();

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnCancelar.InvokeAsync();
    }
}
