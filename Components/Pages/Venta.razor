@page "/venta"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SuperMWeb.Application
@using SuperMWeb.Components.Dialogs
@using SuperMWeb.Domain
@using SuperMWeb.Services
@inject VentaState State
@inject ScannerService Scanner
@inject UiInterop Ui
@inject IProductosRepository ProductosRepo
@inject IVentasRepository VentasRepo
@inject ITicketPrinter Printer
@inject IJSRuntime JS
@inject IConfiguration Config
@inject AuthenticationStateProvider Auth

<PageTitle>Venta - SuperM</PageTitle>

<div class="venta-layout" tabindex="0" @onkeydown="OnKeyDown">

  <div class="venta-principal">

    @* Catalogo: alternativa al lector. Si el escaner se dana o no esta
       disponible, el cajero busca por nombre y agrega con el boton, igual
       que la grilla superior de VentasForm en el escritorio. *@
    <section class="venta-catalogo">
        <div class="catalogo-barra">
            <div class="campo-busqueda">
                <label for="txtBuscarProducto">Buscar producto por nombre</label>
                <input id="txtBuscarProducto"
                       @bind="_filtroCatalogo" @bind:event="oninput" @bind:after="BuscarEnCatalogo"
                       placeholder="Escribe parte del nombre" autocomplete="off" />
            </div>
            @if (_filtroCatalogo.Length > 0)
            {
                <button class="btn btn-secundario btn-mini" @onclick="LimpiarCatalogo">Limpiar</button>
            }
        </div>

        <div class="tabla-scroll catalogo-tabla">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Descripcion</th>
                        <th class="numero">P. venta</th>
                        <th class="numero">Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_catalogo.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="vacio-fila">
                                @(_filtroCatalogo.Length > 0
                                    ? "Ningun producto coincide con la busqueda."
                                    : "Sin productos con existencia.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in _paginaCatalogo)
                        {
                            <tr>
                                <td>@p.Nombre</td>
                                <td>@p.Descripcion</td>
                                <td class="numero">@p.PrecioVenta.ToString("C0")</td>
                                <td class="numero"><span class="stock-pill @ClaseStock(p.Stock)">@p.Stock</span></td>
                                <td>
                                    <button class="btn btn-exito btn-mini" @onclick="() => AgregarDesdeCatalogo(p)">
                                        Agregar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <Paginador TotalFilas="_catalogo.Count"
                   Pagina="_paginaCatalogoActual"
                   TamanoPagina="_tamanoCatalogo"
                   Tamanos="@(new[] { 5, 10, 25, 50 })"
                   OnCambiarPagina="(int p) => _paginaCatalogoActual = p"
                   OnCambiarTamano="CambiarTamanoCatalogo" />
    </section>

    <section class="venta-detalle">
        @if (State.Items.Count == 0)
        {
            <div class="vacio">
                <strong>Listo para vender</strong>
                Escanea un producto o buscalo arriba y pulsa Agregar.
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width:8%">#</th>
                        <th>Producto</th>
                        <th class="numero" style="width:10%">Cant</th>
                        <th class="numero" style="width:18%">V. Unit</th>
                        <th class="numero" style="width:20%">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < State.Items.Count; i++)
                    {
                        var idx = i;
                        var l = State.Items[i];
                        var cls = idx == _seleccionada ? "seleccionada" : null;
                        <tr class="@cls" @onclick="() => Seleccionar(idx)">
                            <td>@(idx + 1)</td>
                            <td>@l.Nombre</td>
                            <td class="numero">@l.Cantidad</td>
                            <td class="numero">@l.PrecioUnitario.ToString("C0")</td>
                            <td class="numero">@l.Subtotal.ToString("C0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
  </div>

    <aside class="venta-totales">
        @if (_feedback is not null)
        {
            <div class="feedback @_feedback.Tipo">@_feedback.Mensaje</div>
        }

        <div>
            <p class="label">Total</p>
            <div class="total">@State.Total.ToString("C0")</div>
            <p class="items-count">@State.Items.Count item(s)</p>
        </div>

        @* Dinero recibido y cambio siempre a la vista, como en el escritorio:
           el cajero digita mientras el cliente le entrega el efectivo, sin
           tener que abrir el dialogo de cobro. *@
        <div class="cobro-rapido">
            <label for="txtRecibidoVenta" class="label">Dinero recibido</label>
            <input id="txtRecibidoVenta"
                   inputmode="numeric"
                   @bind="_recibidoTexto" @bind:event="oninput" @bind:after="ActualizarRecibido"
                   placeholder="0"
                   autocomplete="off" />

            <p class="label">Cambio</p>
            @if (Faltante > 0)
            {
                <div class="cambio-grande faltante">Faltan @Faltante.ToString("C0")</div>
            }
            else
            {
                <div class="cambio-grande">@State.Cambio.ToString("C0")</div>
            }
        </div>

        <button class="btn-cobrar" disabled="@(State.Items.Count == 0)" @onclick="AbrirCobro">
            COBRAR (F10)
        </button>
        <button class="btn-fiar" disabled="@(State.Items.Count == 0)" @onclick="AbrirFiar">
            Fiar venta (F8)
        </button>
        <button class="btn-cancelar" disabled="@(State.Items.Count == 0)" @onclick="CancelarVenta">
            Cancelar venta (Esc)
        </button>
    </aside>

    <div class="venta-atajos">
        <span><kbd>Escanear</kbd> agrega al detalle</span>
        <span><kbd>F2</kbd> cambiar cantidad</span>
        <span><kbd>Del</kbd> eliminar linea seleccionada</span>
        <span><kbd>F8</kbd> fiar</span>
        <span><kbd>F10</kbd> cobrar</span>
        <span><kbd>Esc</kbd> cancelar</span>
    </div>
</div>

@if (_mostrarCobro)
{
    @* Solo confirma, como el ConfirmacionForm del escritorio. El dinero
       recibido y el cambio se digitan en la barra lateral; exigirlos aqui
       obligaria a escribirlos dos veces y bloquearia el cobro. *@
    <ConfirmDialog Titulo="Cobrar venta"
                   Mensaje="@MensajeCobro"
                   OnAceptar="ConfirmarCobro"
                   OnCancelar="() => _mostrarCobro = false" />
}

@if (_mostrarFiar)
{
    <FiarVentaDialog TotalVenta="State.Total"
                     OnFiar="ConfirmarFiado"
                     OnCancelar="() => _mostrarFiar = false" />
}

@if (_mostrarCantidad && _seleccionada >= 0 && _seleccionada < State.Items.Count)
{
    <CantidadDialog Actual="@State.Items[_seleccionada].Cantidad"
                    Nombre="@State.Items[_seleccionada].Nombre"
                    OnConfirmar="AplicarNuevaCantidad"
                    OnCancelar="() => _mostrarCantidad = false" />
}

@code {
    private int _seleccionada = -1;
    private bool _mostrarCobro;
    private bool _mostrarCantidad;
    private bool _mostrarFiar;
    private string? _usuario;

    // Catalogo de respaldo cuando no hay lector
    private IReadOnlyList<ProductoListado> _catalogo = Array.Empty<ProductoListado>();
    private string _filtroCatalogo = string.Empty;
    private int _paginaCatalogoActual = 1;
    private int _tamanoCatalogo = 5;

    private IEnumerable<ProductoListado> _paginaCatalogo =>
        _catalogo.Skip((_paginaCatalogoActual - 1) * _tamanoCatalogo).Take(_tamanoCatalogo);

    // Dinero recibido en la barra lateral
    private string _recibidoTexto = string.Empty;
    private decimal Faltante => Math.Max(0m, State.Total - State.DineroRecibido);
    private FeedbackMsg? _feedback;
    private CancellationTokenSource? _feedbackCts;
    private int _idUsuario;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var claim = auth.User.FindFirst(ClaimTypes.NameIdentifier);
        _idUsuario = int.TryParse(claim?.Value, out var id) ? id : 0;

        // DeudorMovimiento.Usuario guarda el nombre de usuario como texto libre.
        _usuario = auth.User.FindFirst(ClaimTypes.Name)?.Value;

        State.OnCambio += OnVentaCambio;

        await CargarCatalogo();
    }

    // Sin busqueda muestra solo lo que tiene existencia; con busqueda respeta
    // el criterio del escritorio y lista todos los activos que coincidan, de
    // modo que un producto en cero igual aparece y avisa al intentar agregarlo.
    private async Task CargarCatalogo()
    {
        try
        {
            var conFiltro = _filtroCatalogo.Trim().Length > 0;
            _catalogo = await ProductosRepo.ListarAsync(
                filtroNombre: conFiltro ? _filtroCatalogo.Trim() : null,
                limite: conFiltro ? null : 250,
                soloConStock: !conFiltro);
        }
        catch (Exception ex)
        {
            await MostrarFeedback("error", $"No se pudo cargar el catalogo: {ex.Message}");
            _catalogo = Array.Empty<ProductoListado>();
        }
    }

    private async Task BuscarEnCatalogo()
    {
        _paginaCatalogoActual = 1;
        await CargarCatalogo();
    }

    private async Task LimpiarCatalogo()
    {
        _filtroCatalogo = string.Empty;
        _paginaCatalogoActual = 1;
        await CargarCatalogo();
    }

    private void CambiarTamanoCatalogo(int tamano)
    {
        _tamanoCatalogo = tamano;
        var total = Math.Max(1, (int)Math.Ceiling(_catalogo.Count / (double)_tamanoCatalogo));
        if (_paginaCatalogoActual > total) _paginaCatalogoActual = total;
    }

    private static string ClaseStock(int stock) => stock <= 5 ? "bajo" : stock <= 10 ? "medio" : "alto";

    // Agregar desde el catalogo pasa por la misma ruta que el escaneo, para que
    // la validacion de stock y la union de lineas sean identicas.
    private Task AgregarDesdeCatalogo(ProductoListado p) =>
        AgregarAlDetalleAsync(p.IdProducto, p.Nombre, p.PrecioVenta);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await State.RestaurarDesdeStorageAsync(JS);

        Scanner.OnEscaneo += OnEscaneo;
        await Scanner.IniciarAsync();

        await Ui.EnfocarAsync(".venta-layout");
    }

    private async void OnVentaCambio()
    {
        await InvokeAsync(async () =>
        {
            await State.PersistirAsync(JS);
            StateHasChanged();
        });
    }

    private async void OnEscaneo(string codigo)
    {
        if (_mostrarCobro || _mostrarCantidad || _mostrarFiar) return;
        await InvokeAsync(async () => await ProcesarEscaneoAsync(codigo));
    }

    private async Task ProcesarEscaneoAsync(string codigo)
    {
        codigo = codigo?.Trim() ?? string.Empty;
        if (codigo.Length == 0) return;

        Producto? p;
        try { p = await ProductosRepo.BuscarPorCodigoBarrasAsync(codigo); }
        catch (Exception ex)
        {
            await MostrarFeedback("error", $"Error consultando producto: {ex.Message}");
            await Ui.BeepAsync(220, 250);
            return;
        }

        if (p is null)
        {
            await MostrarFeedback("error", $"Producto no encontrado (codigo {codigo}).");
            await Ui.BeepAsync(220, 250);
            return;
        }

        await AgregarAlDetalleAsync(p.IdProducto, p.Nombre, p.PrecioVenta, p.Stock);
    }

    // Ruta unica para agregar un item, venga del lector o del boton Agregar del
    // catalogo: misma validacion de stock y misma union de lineas.
    private async Task AgregarAlDetalleAsync(
        int idProducto, string nombre, decimal precioVenta, int? stockConocido = null)
    {
        var idxExistente = -1;
        for (var i = 0; i < State.Items.Count; i++)
        {
            var l = State.Items[i];
            if (l.IdProducto == idProducto && l.PrecioUnitario == precioVenta)
            { idxExistente = i; break; }
        }

        var cantidadEnVenta = idxExistente >= 0 ? State.Items[idxExistente].Cantidad : 0;

        // El stock se relee de la base en cada intento: el que trae la grilla
        // puede estar viejo si otra caja vendio mientras tanto.
        int stockActual;
        try { stockActual = await ProductosRepo.ObtenerStockAsync(idProducto); }
        catch { stockActual = stockConocido ?? 0; }

        if (stockActual < cantidadEnVenta + 1)
        {
            await MostrarFeedback("error", $"Sin stock: {nombre} (stock actual {stockActual}).");
            await Ui.BeepAsync(220, 250);
            return;
        }

        if (idxExistente >= 0)
        {
            State.CambiarCantidad(idxExistente, cantidadEnVenta + 1);
        }
        else
        {
            State.AgregarLinea(new LineaTicket
            {
                IdProducto = idProducto,
                Nombre = nombre,
                Cantidad = 1,
                PrecioUnitario = precioVenta
            });
        }

        _seleccionada = idxExistente >= 0 ? idxExistente : State.Items.Count - 1;
        await MostrarFeedback("exito", $"{nombre} agregado.");
    }

    // El texto del campo se normaliza con la misma tolerancia que el dialogo de
    // cobro: se ignoran separadores y simbolos y se queda con el numero.
    private void ActualizarRecibido() => State.SetDineroRecibido(ParseDinero(_recibidoTexto));

    private static decimal ParseDinero(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return 0m;
        var limpio = new string(texto.Where(c => char.IsDigit(c) || c == ',' || c == '.').ToArray());
        return decimal.TryParse(limpio, System.Globalization.NumberStyles.Any,
                                System.Globalization.CultureInfo.CurrentCulture, out var d)
            ? d
            : 0m;
    }

    private void Seleccionar(int idx) => _seleccionada = idx;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_mostrarCobro || _mostrarCantidad || _mostrarFiar) return;

        switch (e.Key)
        {
            case "F2":
                if (_seleccionada >= 0) _mostrarCantidad = true;
                break;
            case "Delete":
                if (_seleccionada >= 0)
                {
                    State.EliminarLinea(_seleccionada);
                    _seleccionada = Math.Min(_seleccionada, State.Items.Count - 1);
                }
                break;
            case "F8":
                if (State.Items.Count > 0) _mostrarFiar = true;
                break;
            case "F10":
                if (State.Items.Count > 0) _mostrarCobro = true;
                break;
            case "Escape":
                if (State.Items.Count > 0) await CancelarVenta();
                break;
        }
    }

    private async Task CancelarVenta()
    {
        await ReiniciarVentaAsync();
        await MostrarFeedback("info", "Venta cancelada.");
    }

    // Deja la pantalla lista para la siguiente venta: limpia el detalle, el
    // dinero recibido y refresca el catalogo, cuyo stock acaba de cambiar.
    private async Task ReiniciarVentaAsync()
    {
        State.Reiniciar();
        _seleccionada = -1;
        _recibidoTexto = string.Empty;
        await State.LimpiarStorageAsync(JS);
        await CargarCatalogo();
    }

    private void AbrirCobro() { if (State.Items.Count > 0) _mostrarCobro = true; }

    private void AbrirFiar() { if (State.Items.Count > 0) _mostrarFiar = true; }

    private Task AplicarNuevaCantidad(int nueva)
    {
        State.CambiarCantidad(_seleccionada, nueva);
        _mostrarCantidad = false;
        return Task.CompletedTask;
    }

    // Mensaje de la confirmacion: recuerda el total y, si el cajero ya digito
    // el dinero recibido, tambien el cambio que debe entregar.
    private string MensajeCobro =>
        State.DineroRecibido > 0
            ? $"Finalizar la venta por {State.Total.ToString("C0")}? " +
              $"Recibido {State.DineroRecibido.ToString("C0")}, cambio {State.Cambio.ToString("C0")}."
            : $"Deseas finalizar la venta por {State.Total.ToString("C0")}?";

    private async Task ConfirmarCobro()
    {
        _mostrarCobro = false;

        var recibido = State.DineroRecibido;
        var total = State.Total;
        var items = State.Items.ToList();

        try
        {
            await VentasRepo.RegistrarVentaAsync(_idUsuario, string.Empty, total, items);
        }
        catch (Exception ex)
        {
            await MostrarFeedback("error", $"No se pudo registrar la venta: {ex.Message}");
            await Ui.BeepAsync(220, 400);
            return;
        }

        try
        {
            var nombreNegocio = Config["Negocio:Nombre"] ?? "";
            var bytes = TicketBuilder.ConstruirFactura(items, total, nombreNegocio);
            var res = await Printer.ImprimirAsync(bytes);
            if (!res.Exitoso)
            {
                await MostrarFeedback("error", $"Venta registrada pero fallo la impresion: {res.MensajeError}");
                await Ui.BeepAsync(220, 250);
            }
        }
        catch (Exception ex)
        {
            await MostrarFeedback("error", $"Venta registrada. Error al imprimir: {ex.Message}");
            await Ui.BeepAsync(220, 250);
        }

        var cambio = VentaCalculadora.CalcularCambio(recibido, total);
        await ReiniciarVentaAsync();
        await MostrarFeedback("exito", recibido > 0
            ? $"Venta registrada. Cambio: {cambio.ToString("C0")}"
            : "Venta registrada.");
    }

    // Venta fiada. A diferencia del cobro normal, la venta y el cargo al deudor
    // se registran en una sola transaccion: si algo falla no queda ni la venta
    // ni la deuda. La impresion va despues, fuera de la transaccion.
    private async Task ConfirmarFiado(VentaFiada fiado)
    {
        _mostrarFiar = false;

        var total = State.Total;
        var items = State.Items.ToList();

        try
        {
            await VentasRepo.RegistrarVentaFiadaAsync(_idUsuario, _usuario, total, items, fiado);
        }
        catch (Exception ex)
        {
            await MostrarFeedback("error", $"No se pudo fiar la venta: {ex.Message}");
            await Ui.BeepAsync(220, 400);
            return;
        }

        try
        {
            var nombreNegocio = Config["Negocio:Nombre"] ?? "";
            var bytes = TicketBuilder.ConstruirFactura(items, total, nombreNegocio);
            var res = await Printer.ImprimirAsync(bytes);
            if (!res.Exitoso)
            {
                await MostrarFeedback("error", $"Venta fiada registrada pero fallo la impresion: {res.MensajeError}");
                await Ui.BeepAsync(220, 250);
            }
        }
        catch (Exception ex)
        {
            await MostrarFeedback("error", $"Venta fiada registrada. Error al imprimir: {ex.Message}");
            await Ui.BeepAsync(220, 250);
        }

        await ReiniciarVentaAsync();
        await MostrarFeedback("exito",
            $"Venta fiada a {fiado.NombreCliente} por {fiado.Valor.ToString("C0")}.");
    }

    private async Task MostrarFeedback(string tipo, string mensaje)
    {
        _feedbackCts?.Cancel();
        _feedbackCts = new CancellationTokenSource();
        var token = _feedbackCts.Token;

        _feedback = new FeedbackMsg(tipo, mensaje);
        StateHasChanged();

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), token);
            if (!token.IsCancellationRequested)
            {
                _feedback = null;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Scanner.OnEscaneo -= OnEscaneo;
        State.OnCambio -= OnVentaCambio;
        await Scanner.DetenerAsync();
        _feedbackCts?.Cancel();
    }

    private record FeedbackMsg(string Tipo, string Mensaje);
}
